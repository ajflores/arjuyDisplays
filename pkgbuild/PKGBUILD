pkgname=arjuy-displays
pkgver=0.1.0
pkgrel=1
pkgdesc='Arrange, identify and configure monitors on Omarchy (Hyprland)'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'layer-shell-qt' 'hyprland')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/arjuy-displays "$pkgdir/usr/bin/arjuy-displays"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/arjuy-displays.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/arjuy-displays.svg"
  install -Dm644 "$startdir/arjuy-displays.desktop" "$pkgdir/usr/share/applications/arjuy-displays.desktop"
}
